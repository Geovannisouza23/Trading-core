# Copy to .env and adjust for local (non-docker) development. Every field
# has a safe default in internal/config if omitted; the values below are
# the ones you're most likely to want to change locally. See
# docs/architecture.md for the full variable reference.

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=trading
DATABASE_PASSWORD=trading
DATABASE_NAME=trading_core
DATABASE_SSL_MODE=disable

# --- Broker (PAPER | TESTNET | REAL) ---
BROKER_MODE=PAPER
BROKER_PAPER_STARTING_BALANCE=10000
# Only needed for TESTNET/REAL:
# BROKER_BINANCE_API_KEY=
# BROKER_BINANCE_API_SECRET=
# Only needed for REAL (see docs/decisions and section 14 of the original spec):
# BROKER_REAL_TRADING_ENABLED=true
# BROKER_REAL_TRADING_CONFIRMATION=I_UNDERSTAND_THE_RISK

# --- Risk ---
RISK_PER_TRADE_PCT=0.03
RISK_MAX_DAILY_LOSS_PCT=0.09
RISK_MAX_WEEKLY_LOSS_PCT=0.15
RISK_MAX_DRAWDOWN_PCT=0.25
RISK_MAX_OPEN_POSITIONS=1
RISK_MAX_LEVERAGE=1

# --- LLM (noop | gemini) ---
LLM_PROVIDER=noop
# LLM_GEMINI_API_KEY=

# --- Quant Engine ---
# fake: deterministic in-process momentum rule, no network — the default,
#       safe for local PAPER runs without quant-engine up.
# grpc: real gRPC client against a running quant-engine (QUANT_GRPC_TARGET).
#       Unlocks backtest/optimization/dataset-export/diagnostics HTTP
#       endpoints too — those return a clear error in fake mode, since
#       there is no meaningful fake for a backtest or a model reload.
#       See docs/decisions/0010-real-grpc-client-for-quant-engine.md.
QUANT_MODE=fake
QUANT_GRPC_TARGET=localhost:50051
QUANT_TIMEOUT=5s

# --- NATS (optional — publishes to quant.decision.outcome.received and
# quant.model.approved, the two subjects quant-engine's own NATS
# consumers already expect; also subscribes to quant-engine's
# backtest/optimization completion events for dashboard push. Falls back
# to the in-memory EventBus if unset/unreachable and NATS_REQUIRED=false.
# Point this at quant-engine's own NATS — see docs/local-development.md
# for the shared aegis-net Docker network setup; do not run a second,
# isolated NATS for this repo.) ---
NATS_URL=nats://localhost:4222
NATS_REQUIRED=false

# --- Redis (optional — market-data caching for FetchKlines, and shared
# idempotency dedup with quant-engine's NATS consumers. Point this at the
# same Redis quant-engine's docker-compose brings up, same reasoning as
# NATS above.) ---
REDIS_ADDR=localhost:6379
REDIS_REQUIRED=false

# --- Observability ---
OBSERVABILITY_LOG_LEVEL=info
OBSERVABILITY_LOG_FORMAT=json

# --- Security ---
# Must be >= 32 chars. If omitted, an insecure development default is used
# and a warning is logged at startup.
SECURITY_JWT_SIGNING_SECRET=local-development-secret-change-me-32chars
# SECURITY_TELEGRAM_BOT_TOKEN=
# SECURITY_TELEGRAM_CHAT_ID=
