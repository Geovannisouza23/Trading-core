# Copy to .env and adjust for local (non-docker) development. Every field
# has a safe default in internal/config if omitted; the values below are
# the ones you're most likely to want to change locally. See
# docs/architecture.md for the full variable reference.

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=trading
DATABASE_PASSWORD=trading
DATABASE_NAME=trading_core
DATABASE_SSL_MODE=disable

# --- Broker (PAPER | TESTNET | REAL) ---
BROKER_MODE=PAPER
BROKER_PAPER_STARTING_BALANCE=10000
# Only needed for TESTNET/REAL:
# BROKER_BINANCE_API_KEY=
# BROKER_BINANCE_API_SECRET=
# Only needed for REAL (see docs/decisions and section 14 of the original spec):
# BROKER_REAL_TRADING_ENABLED=true
# BROKER_REAL_TRADING_CONFIRMATION=I_UNDERSTAND_THE_RISK

# --- Risk ---
RISK_PER_TRADE_PCT=0.03
RISK_MAX_DAILY_LOSS_PCT=0.09
RISK_MAX_WEEKLY_LOSS_PCT=0.15
RISK_MAX_DRAWDOWN_PCT=0.25
RISK_MAX_OPEN_POSITIONS=1
RISK_MAX_LEVERAGE=1

# --- LLM (noop | gemini) ---
LLM_PROVIDER=noop
# LLM_GEMINI_API_KEY=

# --- Quant (fake is the only implemented mode in this delivery) ---
QUANT_MODE=fake

# --- Observability ---
OBSERVABILITY_LOG_LEVEL=info
OBSERVABILITY_LOG_FORMAT=json

# --- Security ---
# Must be >= 32 chars. If omitted, an insecure development default is used
# and a warning is logged at startup.
SECURITY_JWT_SIGNING_SECRET=local-development-secret-change-me-32chars
# SECURITY_TELEGRAM_BOT_TOKEN=
# SECURITY_TELEGRAM_CHAT_ID=
